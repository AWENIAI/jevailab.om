<view class="ref">
  <view class="label">
    参考图
    <text class="req" wx:if="{{policy === 'required'}}">（必填）</text>
    <text class="opt" wx:elif="{{policy === 'optional'}}">（可选 · 图生图）</text>
    <text class="ban" wx:elif="{{policy === 'forbidden'}}">（本模板不支持）</text>
  </view>

  <view wx:if="{{policy === 'forbidden'}}" class="placeholder banned">该模板不支持参考图</view>

  <block wx:else>
    <view wx:if="{{assetId}}" class="thumb-wrap">
      <image class="thumb" src="{{previewUrl}}" mode="aspectFill" lazy-load="true" />
      <view class="remove" catchtap="onRemove">×</view>
    </view>
    <view wx:else class="placeholder" bindtap="onChoose">
      <text class="plus">＋</text>
      <text class="tip">{{uploading ? '上传审核中…' : '上传参考图（垫图 / 编辑）'}}</text>
    </view>
  </block>
</view>
