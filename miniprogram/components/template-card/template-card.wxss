.tpl-card {
  background: var(--surface);
  border: 2rpx solid var(--border);
  border-radius: 18rpx;
  padding: 14rpx;
  width: 220rpx;
  box-sizing: border-box;
}
.tpl-card.selected {
  border-color: var(--accent);
  background: rgba(232, 163, 61, 0.08);
}
.cover-wrap {
  width: 100%;
  aspect-ratio: 3 / 4;
  border-radius: 12rpx;
  overflow: hidden;
  background: var(--surface-2);
}
.cover { width: 100%; height: 100%; }
.name {
  font-size: 26rpx;
  font-weight: 600;
  margin-top: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.desc {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
