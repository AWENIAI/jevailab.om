/* Jevailab 小程序全局样式：深色优先 + 单一琥珀强调色，沿用官网极简语言 */
page {
  --bg: #0c0c0c;
  --surface: #161616;
  --surface-2: #1f1f1f;
  --border: #2a2a2a;
  --text: #f2f2f0;
  --text-2: #a8a69e;
  --text-3: #6f6d66;
  --accent: #e8a33d; /* 琥珀强调色 */
  --accent-press: #c9872a;
  --danger: #e24b4a;
  --success: #3b6d11;

  background: var(--bg);
  color: var(--text);
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 24rpx 28rpx calc(180rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 卡片 */
.card {
  background: var(--surface);
  border: 1rpx solid var(--border);
  border-radius: 20rpx;
  padding: 24rpx;
}

/* 主操作按钮 */
.btn-primary {
  background: var(--accent);
  color: #1a1206;
  font-weight: 600;
  border-radius: 14rpx;
  padding: 22rpx 0;
  text-align: center;
  font-size: 30rpx;
}
.btn-primary.btn-disabled {
  background: var(--surface-2);
  color: var(--text-3);
}
.btn-ghost {
  background: transparent;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 20rpx 0;
  text-align: center;
  font-size: 28rpx;
}

/* 文本辅助 */
.muted { color: var(--text-2); }
.hint { color: var(--text-3); font-size: 24rpx; }
.title { font-size: 34rpx; font-weight: 600; }
.section-gap { margin-top: 28rpx; }

/* 标签 / chip */
.chip {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: var(--surface-2);
  color: var(--text-2);
  font-size: 24rpx;
  border: 1rpx solid var(--border);
}
.chip.active {
  background: rgba(232, 163, 61, 0.16);
  color: var(--accent);
  border-color: var(--accent);
}

/* 输入 */
.input,
.textarea {
  background: var(--surface-2);
  border: 1rpx solid var(--border);
  border-radius: 14rpx;
  padding: 20rpx;
  color: var(--text);
  width: 100%;
  box-sizing: border-box;
}
.textarea { min-height: 160rpx; }

/* 价格/积分强调 */
.credit { color: var(--accent); font-weight: 600; }
